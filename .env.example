# ---------------------------------------------------------------------------
# Database connection for bookings.
# Copy this file to ".env" and paste your real connection string below.
#
# Easiest free options (any works):
#   • Vercel Postgres / Neon  — https://vercel.com/storage/postgres
#   • Supabase                — https://supabase.com  (use the "Connection string")
#
# It must be a PostgreSQL URL, e.g.:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/vickyslashlab?sslmode=require"

# ---------------------------------------------------------------------------
# Admin dashboard (/admin). Set a password to unlock the bookings view.
# Until this is set, /admin shows a "not set up yet" note.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD="change-me-to-something-strong"

# ---------------------------------------------------------------------------
# Booking confirmation emails via Resend (https://resend.com). Optional —
# bookings work without these; they just won't send email until configured.
#   1. Create a free Resend account + API key.
#   2. Verify a sending domain, then use an address on it below.
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# The "from" address (must be on a domain you've verified in Resend):
BOOKING_FROM_EMAIL="Vicky's Lash Lab <bookings@vickyslashlab.com>"
# Where Vicky gets notified of new bookings (any inbox):
STUDIO_NOTIFY_EMAIL="vicky@vickyslashlab.com"
