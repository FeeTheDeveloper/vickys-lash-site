// Vicky's Lash Lab — booking persistence on Supabase Postgres.
// The Vercel Supabase integration sets both URLs automatically:
//   POSTGRES_PRISMA_URL      — pooled (pgbouncer) connection used at runtime
//   POSTGRES_URL_NON_POOLING — direct connection used by `npm run db:push`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Booking {
  id        String   @id @default(cuid())
  // Local calendar date of the appointment, stored as YYYY-MM-DD
  date      String
  // Minutes-from-midnight for start/end (matches the scheduler engine)
  start     Int
  end       Int
  serviceId String
  service   String
  price     Int
  name      String
  email     String?
  phone     String?
  // confirmed | cancelled — cancelled rows free their slot but stay for audit
  status    String   @default("confirmed")
  // Client-generated key so a double-submitted form creates one booking
  idempotencyKey String? @unique
  createdAt DateTime @default(now())

  // Overlap protection lives in the API: bookings for a date are serialized
  // with a Postgres advisory lock, then checked against every interval that
  // day (a unique index can't express "no overlapping time ranges").
  @@index([date])
}
